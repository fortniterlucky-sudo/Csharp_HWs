using System;\
\
class Program\
\{\
    static void Main()\
    \{\
        ICombatant knight = new Knight("\uc0\u1040 \u1088 \u1090 \u1091 \u1088 ");\
        ICombatant mage = new Mage("\uc0\u1052 \u1077 \u1088 \u1083 \u1080 \u1085 ");\
\
        while (!knight.IsDead && !mage.IsDead)\
        \{\
            knight.Attack(mage);\
\
            if (!mage.IsDead)\
            \{\
                mage.Attack(knight);\
            \}\
        \}\
\
        if (knight.IsDead)\
        \{\
            Console.WriteLine($"\uc0\u1055 \u1086 \u1073 \u1077 \u1076 \u1080 \u1083  \u1052 \u1072 \u1075  \{mage.Name\}!");\
        \}\
        else\
        \{\
            Console.WriteLine($"\uc0\u1055 \u1086 \u1073 \u1077 \u1076 \u1080 \u1083  \u1056 \u1099 \u1094 \u1072 \u1088 \u1100  \{knight.Name\}!");\
        \}\
    \}\
\}\
\
public interface ICombatant\
\{\
    string Name \{ get; \}\
    int HP \{ get; set; \}\
    bool IsDead \{ get; \}\
    int Damage \{ get; \}\
\
    void Attack(ICombatant target);\
    void TakeDamage(int amount);\
\}\
\
public class Knight : ICombatant\
\{\
    public string Name \{ get; \}\
    public int HP \{ get; set; \} = 150;\
    public int Damage \{ get; \} = 25;\
    public bool IsDead => HP <= 0;\
\
    public Knight(string name)\
    \{\
        Name = name;\
    \}\
\
    public void Attack(ICombatant target)\
    \{\
        if (IsDead)\
        \{\
            Console.WriteLine($"\uc0\u1056 \u1099 \u1094 \u1072 \u1088 \u1100  \{Name\} \u1084 \u1105 \u1088 \u1090 \u1074  \u1080  \u1085 \u1077  \u1084 \u1086 \u1078 \u1077 \u1090  \u1072 \u1090 \u1072 \u1082 \u1086 \u1074 \u1072 \u1090 \u1100 ");\
            return;\
        \}\
\
        if (target.IsDead)\
        \{\
            Console.WriteLine($"\uc0\u1056 \u1099 \u1094 \u1072 \u1088 \u1100  \{Name\} \u1085 \u1077  \u1084 \u1086 \u1078 \u1077 \u1090  \u1072 \u1090 \u1072 \u1082 \u1086 \u1074 \u1072 \u1090 \u1100  \u1084 \u1105 \u1088 \u1090 \u1074 \u1091 \u1102  \u1094 \u1077 \u1083 \u1100 ");\
            return;\
        \}\
\
        Console.WriteLine($"\uc0\u1056 \u1099 \u1094 \u1072 \u1088 \u1100  \{Name\} \u1072 \u1090 \u1072 \u1082 \u1091 \u1077 \u1090 !");\
        target.TakeDamage(Damage);\
    \}\
\
    public void TakeDamage(int amount)\
    \{\
